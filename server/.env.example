# ==========================================
# KONFIGURASI SERVER
# ==========================================
PORT=3001
NODE_ENV=development

# PENTING: Generate JWT secret yang kuat dengan perintah:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_YANG_KUAT

# ==========================================
# CORS (Production)
# ==========================================
# Isi dengan domain frontend production, pisahkan dengan koma
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==========================================
# OPSI A: POSTGRESQL DI LOCALHOST (pgAdmin / Postgres App)
# ==========================================
# Ubah DB_DIALECT ke postgres untuk mengaktifkan PostgreSQL
# DB_DIALECT=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=kp4_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_SSL=false

# ==========================================
# OPSI B: POSTGRESQL CLOUD (Supabase, Neon.tech, Railway, Render, dll.)
# ==========================================
# Jika menggunakan cloud hosting database, cukup isi DATABASE_URL berikut:
# DATABASE_URL=postgresql://user:password@ep-cool-host.neon.tech/kp4_db?sslmode=require
# DB_SSL=true

# ==========================================
# CATATAN:
# Jika semua baris DB_* dan DATABASE_URL dikosongkan/dikomentari,
# aplikasi secara otomatis menggunakan SQLite bawaan (kp4.sqlite) tanpa setup tambahan.
# ==========================================
